# Defense-in-depth fallback. The published package is governed by the
# package.json "files" allowlist (which uses "!" negations to drop tests,
# fixtures, and maintainer docs). npm bypasses this root .npmignore inside
# any directory "files" lists, so these rules only take effect if the
# "files" field is ever removed - then they exclude the same dev material.
.idea/
.agents/
.claude/
.codex/
.github/
.goat-flow/
node_modules/

# Tests and test fixtures - not runtime/user-facing
src/**/*.test.ts
/src/fixtures/
/fixtures/

# Maintainer/release shell tooling - not runtime/user-facing
/scripts/

# Maintainer/contributor docs - not user-facing
/docs/releasing.md
/docs/coding-standards/

AGENTS.md
CLAUDE.md
.gruff-ts.yaml

.env
.env.*
!.env.example

*.log
npm-debug.log*
coverage/
.nyc_output/
*.tsbuildinfo
